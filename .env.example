# ─────────────────────────────────────────────────────────────────────────────
# Database
# Get your connection string from your PostgreSQL provider.
# Local dev:  start Postgres with `docker compose up -d` and use the URL below.
# Production: Neon serverless Postgres — https://neon.tech (free tier available)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop_app_v2

# ─────────────────────────────────────────────────────────────────────────────
# API server
# ─────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
PLATFORM_EVENT_DELIVERY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# Generate a secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
# Set to true in production (requires HTTPS). Defaults to true unless NODE_ENV=development.
AUTH_COOKIE_SECURE=false

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Frontend / CORS
# WEB_BASE_URL — used by the API to build email links and OAuth redirect URLs.
# API_BASE_URL — used by Next.js rewrites to proxy API requests same-origin.
# Keep this non-public unless the browser must call a separate API origin.
# ─────────────────────────────────────────────────────────────────────────────
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Deployment note:
# - local dev commands use the :local seed scripts and .env.local
# - CI / shared test environments should export these variables directly and use:
#   pnpm deploy:testing:bootstrap
#   pnpm deploy:testing:seed-admin

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth (optional — leave blank to disable "Continue with Google")
#
# Setup steps:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Authorised redirect URIs:
#      - Local dev: http://localhost:4000/api/auth/oauth/google/callback
#      - Production: https://your-api.railway.app/api/auth/oauth/google/callback
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Email — Resend (optional — leave RESEND_API_KEY blank to log emails to console)
#
# Setup steps:
#   1. Sign up at https://resend.com (free tier: 3,000 emails/month)
#   2. Create an API key under API Keys
#   3. Add and verify your sending domain under Domains
#   4. Set EMAIL_FROM_ADDRESS to an address on your verified domain
#   5. Create a webhook and copy its signing secret into RESEND_WEBHOOK_SECRET
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — media storage (images & video)
# R2 has zero egress costs and a generous free tier (10 GB storage/month).
# It is S3-compatible — the same @aws-sdk/client-s3 package is used.
#
# Setup steps:
#   1. Create a Cloudflare account at https://dash.cloudflare.com
#   2. Go to R2 Object Storage → Create bucket (e.g. "shop-media")
#   3. Go to R2 → Manage R2 API Tokens → Create API Token
#      Grant "Object Read & Write" on your bucket.
#      Note the Access Key ID and Secret Access Key shown after creation.
#   4. Your Account ID is shown in the R2 dashboard URL:
#      https://dash.cloudflare.com/<ACCOUNT_ID>/r2/...
#   5. Enable public access so uploaded files are publicly readable:
#      Bucket → Settings → Public Access → Allow Access
#      The public URL will be: https://pub-<token>.r2.dev
#      Or configure a custom domain via Cloudflare DNS (recommended).
#
# Leave blank to disable media uploads (the API will return 503 for media endpoints).
# ─────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shop-media
# Public base URL for your R2 bucket — no trailing slash.
# Example: https://pub-abc123.r2.dev  OR  https://media.yourdomain.com
R2_PUBLIC_URL=

# Shared test-environment bootstrap user
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
