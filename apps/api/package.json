{
  "name": "@shop/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "tsx watch src/index.ts",
    "lint": "biome check src test",
    "predev": "pnpm --filter @shop/contracts build",
    "pretest": "pnpm --filter @shop/contracts build",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shop/contracts": "workspace:*",
    "@shop/domain": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6"
  }
}
