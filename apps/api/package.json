{
  "name": "@shop/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:seed-access-control": "tsx scripts/seed-access-control.ts",
    "db:seed-access-control:local": "tsx --env-file ../../.env.local scripts/seed-access-control.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "db:seed-admin:local": "tsx --env-file ../../.env.local scripts/seed-admin.ts",
    "db:seed-catalog": "tsx scripts/seed-catalog.ts",
    "db:seed-catalog:local": "tsx --env-file ../../.env.local scripts/seed-catalog.ts",
    "db:seed-core": "pnpm db:seed-access-control && pnpm db:seed-catalog",
    "dev": "tsx watch --env-file ../../.env.local src/index.ts",
    "dev:events": "tsx watch --env-file ../../.env.local src/workers/platform-event-delivery-worker.ts",
    "email:review-fixtures": "pnpm build && node scripts/generate-email-review-fixtures.mjs",
    "events:worker": "tsx --env-file ../../.env.local src/workers/platform-event-delivery-worker.ts",
    "lint": "biome check src test",
    "predev": "pnpm --filter @shop/contracts build && pnpm --filter @shop/database build && pnpm --filter @shop/domain build",
    "pretest": "pnpm --filter @shop/contracts build && pnpm --filter @shop/database build && pnpm --filter @shop/domain build",
    "start": "node dist/src/index.js",
    "start:events": "node dist/src/workers/platform-event-delivery-worker.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@shop/contracts": "workspace:*",
    "@shop/database": "workspace:*",
    "@shop/domain": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "fastify": "^5.2.1",
    "openid-client": "^6.8.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "resend": "^6.12.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.6"
  }
}
